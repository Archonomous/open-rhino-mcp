{
  "name": "open-rhino-mcp",
  "version": "0.1.3",
  "description": "MCP server that lets AI agents drive Rhino 7 through the Open Rhino MCP plug-in.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Archonomous/open-rhino-mcp.git",
    "directory": "server"
  },
  "type": "module",
  "bin": {
    "open-rhino-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run typecheck && npm run bundle",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "pack:mcpb": "npm run build && node scripts/pack-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
